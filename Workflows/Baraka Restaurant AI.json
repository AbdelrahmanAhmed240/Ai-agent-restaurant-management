    },
    {
      "parameters": {
        "description": "MANDATORY ONLY after the customer has explicitly confirmed a NEW order.\nNever use for MODIFY or CANCEL.\nReturn a non-empty unique Order ID.\nIf generation fails, the agent must not write or claim confirmation.\n",
        "jsCode": "const now = Date.now();\nconst random = Math.floor(Math.random() * 900 + 100);\nreturn JSON.stringify({order_ID:`ORD-${String(now).slice(-8)}-${random}`});"
      },
