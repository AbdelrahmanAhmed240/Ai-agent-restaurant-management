    {
      "parameters": {
        "description": "MANDATORY before Calculate_tool for NEW or MODIFY.\nInput must contain the COMPLETE cart:\n{\"items\":[{\"name\":\"exact menu item name including confirmed sauce/combo\",\"quantity\":1,\"unit_price\":123}]}\nDo not omit unchanged items during modification.\nDo not create free sauce as a separate item.\nCombo unit_price must already be base + Vector Store combo add-on price.\nReject empty/invalid carts.\n",
        "jsCode": "const raw = $input.first().json;\nlet data = raw.input ?? raw.query ?? raw;\nif (typeof data === 'string') data = JSON.parse(data);\n\nconst items = Array.isArray(data.items) ? data.items : [];\nif (!items.length) throw new Error('EMPTY_CART');\n\nconst normalized = [];\nfor (const item of items) {\n  const name = String(item.name ?? '').trim();\n  const quantity = Number(item.quantity);\n  const unitPrice = Number(item.unit_price);\n\n  if (!name || !Number.isFinite(quantity) || quantity <= 0 ||\n      !Number.isFinite(unitPrice) || unitPrice < 0) {\n    throw new Error('INVALID_CART_ITEM');\n  }\n\n  normalized.push({\n    name,\n    quantity,\n    unit_price: unitPrice,\n    line_total: quantity * unitPrice\n  });\n}\n\nconst total = normalized.reduce((s, i) => s + i.line_total, 0);\n\nreturn JSON.stringify({\n  items: normalized,\n  order_Item: normalized.map(i => `${i.name} x${i.quantity}`).join(' | '),\n  order_Price: total,\n  total,\n  currency: 'EGP'\n});"
      },
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
      "position": [
        -640,
        1280
      ],
      "id": "737da5de-ef4a-4c3c-94d4-d7e34d4b000c",
      "name": "build_cart",
      "rewireOutputLogTo": "ai_tool"
    },
    {
      "parameters": {
        "description": "MANDATORY after build_cart for every NEW order and every MODIFY.\nInput MUST be the COMPLETE cart.\nNever accept partial-cart calculations.\nReturn exact total only from the supplied validated cart.\nIf invalid, fail and STOP the order workflow.\n",
        "jsCode": "const raw = $input.first().json;\nlet data = raw.input ?? raw.query ?? raw;\nif (typeof data === 'string') data = JSON.parse(data);\n\nconst items = Array.isArray(data.items) ? data.items : [];\nif (!items.length) throw new Error('EMPTY_CART');\n\nlet total = 0;\nconst result = items.map(i => {\n  const quantity = Number(i.quantity);\n  const unit_price = Number(i.unit_price);\n  if (!Number.isFinite(quantity) || quantity <= 0 ||\n      !Number.isFinite(unit_price) || unit_price < 0) {\n    throw new Error('INVALID_CART');\n  }\n  const line_total = quantity * unit_price;\n  total += line_total;\n  return {name:String(i.name), quantity, unit_price, line_total};\n});\n\nreturn JSON.stringify({\n  items: result,\n  subtotal: total,\n  total,\n  order_Price: total,\n  currency: 'EGP'\n});"
      },
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
