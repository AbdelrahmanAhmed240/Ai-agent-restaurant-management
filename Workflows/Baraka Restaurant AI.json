    {
      "parameters": {
        "description": "Use before read_tool.\nRequires BOTH Order ID and Phone.\nNormalizes Egyptian phone numbers to digits without leading 20/0.\nNever authorizes using only one field.\n",
        "jsCode": "const raw = $input.first().json;\nlet data = raw.input ?? raw.query ?? raw;\nif (typeof data === 'string') data = JSON.parse(data);\n\nconst orderId = String(data.order_ID ?? data['Order ID'] ?? '').trim();\nlet phone = String(data.phone_number ?? data['Phone Number'] ?? '').replace(/\\D/g,'');\n\nif (phone.startsWith('20')) phone = phone.slice(2);\nif (phone.startsWith('0')) phone = phone.slice(1);\n\nif (!orderId || !phone) {\n  return JSON.stringify({verified:false, reason:'MISSING_ORDER_ID_OR_PHONE'});\n}\nreturn JSON.stringify({\n  verified:true,\n  order_ID:orderId,\n  phone_number:phone\n});"
      },
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
      "position": [
        -192,
        1280
      ],
      "id": "20e605bc-c8cf-4a4f-84ca-a44df230c4e1",
      "name": "normalize_order_identity",
      "rewireOutputLogTo": "ai_tool"
    },
    {
      "parameters": {
        "description": "MANDATORY for MODIFY and CANCEL.\nInput MUST be the COMPLETE official record returned by read_tool.\nRules:\n- status must be exactly In Kitchen\n- Time must be valid\n- current time must not be before order time\n- elapsed time must be < 30 minutes\nAt 30:00 or later, deny.\nThis result is authoritative.\nIf denied, Calculate_tool and edit_tool MUST NOT be called.\n",
        "jsCode": "const order = $input.first().json.input ?? $input.first().json;\nconst CONFIG = {limit:30, zone:'Africa/Cairo'};\n\nfunction deny(reason, extra={}) {\n  return JSON.stringify({allowed:false, reason, ...extra});\n}\n\nif (!order || typeof order !== 'object') return deny('MISSING_ORDER_RECORD');\n\nconst rawTime = String(order.Time ?? '').trim();\nconst status = String(order.Status ?? '').trim();\n\nif (!rawTime) return deny('MISSING_ORDER_TIME');\nif (status !== 'In Kitchen') return deny('INVALID_ORDER_STATUS',{status});\n\nconst orderDate = DateTime.fromFormat(rawTime,'yyyy-MM-dd HH:mm:ss',{zone:CONFIG.zone});\nif (!orderDate.isValid) return deny('INVALID_ORDER_TIME');\n\nconst now = DateTime.now().setZone(CONFIG.zone);\nconst elapsed = now.diff(orderDate,'minutes').minutes;\n\nif (elapsed < 0) return deny('INVALID_FUTURE_ORDER_TIME',{minutes_elapsed:Math.floor(elapsed)});\nif (elapsed >= CONFIG.limit) {\n  return deny('MODIFICATION_WINDOW_EXPIRED',{\n    minutes_elapsed:Math.floor(elapsed),\n    limit_minutes:CONFIG.limit,\n    status\n  });\n}\n\nreturn JSON.stringify({\n  allowed:true,\n  reason:'ORDER_CAN_BE_MODIFIED',\n  minutes_elapsed:Math.floor(elapsed),\n  remaining_minutes:Math.ceil(CONFIG.limit-elapsed),\n  limit_minutes:CONFIG.limit,\n  status\n});"
      },
